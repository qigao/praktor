    },
    {
      "name": "install-android-arm64-v8a-debug-win",
      "configurePreset": "android-arm64-v8a-debug-win",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-android-arm64-v8a-release-win",
      "configurePreset": "android-arm64-v8a-release-win",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-android-x86_64-debug-win",
      "configurePreset": "android-x86_64-debug-win",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-android-x86_64-release-win",
      "configurePreset": "android-x86_64-release-win",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-android-x86-debug-win",
      "configurePreset": "android-x86-debug-win",
      "targets": [
