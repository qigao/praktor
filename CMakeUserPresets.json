{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "ci-sdk-base",
      "hidden": true,
      "inherits": "vcpkg-cache-ci",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-sdk",
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "TURBOSCRIPT_ROOT": "$penv{TURBOSCRIPT_ROOT}",
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
        "PKG_ROOT": "${sourceDir}/stage",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/ci",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/ci-sdk/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/ci-sdk/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$penv{TRIPLET}/lib${pathListSep}$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "DYLD_LIBRARY_PATH": "${sourceDir}/build/ci-sdk/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$penv{TRIPLET}/lib${pathListSep}$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_TESTS": true,
        "ENABLE_SCRIPT_ENGINE": true,
        "ENABLE_SANITIZER_ADDRESS": false,
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "$penv{TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$penv{HOST_TRIPLET}",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$penv{TRIPLET}",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/$penv{RID}"
      }
    },
    {
      "name": "ci-linux-sdk",
      "inherits": [
        "ci-sdk-base",
        "Gcc",
        "flags-gnu"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ci-macos-sdk",
      "inherits": [
        "ci-sdk-base",
        "AppleClang",
        "flags-darwin"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-android-sdk",
      "inherits": [
        "ci-sdk-base",
        "android-base"
      ],
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ENABLE_TESTS": false,
        "PRAKTOR_HOST_LEMON_EXECUTABLE": "$penv{PRAKTOR_HOST_LEMON_EXECUTABLE}"
      }
    },
    {
      "name": "vcpkg-cache-ci",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
        "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}"
      }
    },
    {
      "name": "vcpkg-cache-linux",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-linux"
      },
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
      }
    },
    {
      "name": "vcpkg-cache-windows",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-windows"
      },
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
        "RE2C_ROOT": "$env{PKG_ROOT}/re2c/windows-x64"
      }
    },
    {
      "name": "vcpkg-cache",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,${sourceDir}/cmake/vcpkg-cache.nuget.config,read",
        "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
        "RE2C_ROOT": "$penv{RE2C_ROOT}",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "win-toolchain",
      "hidden": true,
      "environment": {
        "PROJECT_ROOT": "C:/projects/cpp",
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_ROOT": "C:/tools/vcpkg",
        "USER_ROOT": "C:/Users/lockg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "inherits": [
        "vcpkg-cache-windows"
      ]
    },
    {
      "name": "win-paths",
      "hidden": true,
      "inherits": "win-toolchain",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "linux-paths",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "environment": {
        "PKG_ROOT": "/opt",
        "VCPKG_ROOT": "/opt/vcpkg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "inherits": [
        "vcpkg-cache-linux"
      ]
    },
    {
      "name": "android-win-environment",
      "hidden": true,
      "inherits": "win-toolchain",
      "environment": {
        "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
        "ANDROID_NDK_VERSION": "28.2.13676358",
        "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
      }
    },
    {
      "name": "android-win-user-paths",
      "hidden": true,
      "inherits": [
        "vcpkg-cache-windows",
        "android-win-paths",
        "ISWindows"
      ],
      "environment": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/android"
      },
      "cacheVariables": {
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
      }
    },
    {
      "name": "win-dev-user",
      "inherits": [
        "base-win-dev-user",
        "win-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
        "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/debug",
        "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script/debug",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$env{TURBOSCRIPT_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor/debug"
      }
    },
    {
      "name": "win-release-user",
      "inherits": [
        "base-win-release-user",
        "win-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "TURBOSCRIPT_ROOT": "$penv{TURBOSCRIPT_ROOT}",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$env{TURBOSCRIPT_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
        "ENABLE_TESTS": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor/release"
      }
    },
    {
      "name": "linux-dev-user",
      "inherits": [
        "base-linux-dev-user",
        "linux-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
        "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/debug",
        "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script/debug",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor/debug"
      }
    },
    {
      "name": "linux-release-user",
      "inherits": [
        "release-linux-ninja",
        "linux-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "TURBOSCRIPT_ROOT": "$penv{TURBOSCRIPT_ROOT}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "ENABLE_TESTS": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor/release"
      }
    },
    {
      "name": "linux-sdk-package",
      "inherits": [
        "linux-release-user"
      ],
      "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_TESTS": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "android-dependencies-debug",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug",
        "CHTTP_ROOT": "$env{PKG_ROOT}/chttp-android/debug",
        "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script-android/debug"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor-android/debug"
      }
    },
    {
      "name": "android-dependencies-release",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "CHTTP_ROOT": "$penv{CHTTP_ROOT}",
        "TURBOSCRIPT_ROOT": "$penv{TURBOSCRIPT_ROOT}"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor-android/release",
        "PRAKTOR_HOST_LEMON_EXECUTABLE": "$penv{PRAKTOR_HOST_LEMON_EXECUTABLE}"
      }
    },
    {
      "name": "android-arm64-v8a-debug-win",
      "inherits": [
        "android-arm64-v8a-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-arm64-v8a-release-win",
      "inherits": [
        "android-arm64-v8a-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86_64-debug-win",
      "inherits": [
        "android-x86_64-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86_64-release-win",
      "inherits": [
        "android-x86_64-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86-debug-win",
      "inherits": [
        "android-x86-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86-release-win",
      "inherits": [
        "android-x86-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "win-dev-user",
      "configurePreset": "win-dev-user"
    },
    {
      "name": "win-release-user",
      "configurePreset": "win-release-user"
    },
    {
      "name": "linux-dev-user",
      "configurePreset": "linux-dev-user"
    },
    {
      "name": "linux-release-user",
      "configurePreset": "linux-release-user"
    },
    {
      "name": "linux-sdk-package",
      "configurePreset": "linux-sdk-package"
    },
    {
      "name": "install-win-dev-user",
      "configurePreset": "win-dev-user",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-win-release-user",
      "configurePreset": "win-release-user",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-linux-dev-user",
      "configurePreset": "linux-dev-user",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-linux-release-user",
      "configurePreset": "linux-release-user",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-linux-sdk-package",
      "configurePreset": "linux-sdk-package",
      "targets": [
        "install"
      ]
    },
    {
      "name": "android-arm64-v8a-debug-win",
      "configurePreset": "android-arm64-v8a-debug-win"
    },
    {
      "name": "android-arm64-v8a-release-win",
