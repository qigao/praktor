      ]
    },
    {
      "name": "install-android-x86-release-win",
      "configurePreset": "android-x86-release-win",
      "targets": [
        "install"
      ]
    },
    {
      "name": "ci-linux-sdk",
      "configurePreset": "ci-linux-sdk"
    },
    {
      "name": "install-ci-linux-sdk",
      "configurePreset": "ci-linux-sdk",
      "targets": [
        "install"
      ]
    },
    {
