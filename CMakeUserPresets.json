      "name": "install-ci-android-sdk",
      "configurePreset": "ci-android-sdk",
      "targets": [
        "install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "win-dev-user",
      "inherits": "base-test",
      "configurePreset": "win-dev-user"
    },
    {
      "name": "win-release-user",
      "inherits": "base-test",
      "configurePreset": "win-release-user"
    },
    {
      "name": "linux-dev-user",
      "inherits": "base-test",
      "configurePreset": "linux-dev-user"
    },
    {
      "name": "linux-release-user",
      "inherits": "base-test",
      "configurePreset": "linux-release-user"
    },
    {
      "name": "ci-linux-sdk",
      "inherits": "base-test",
      "configurePreset": "ci-linux-sdk"
    },
    {
      "name": "ci-macos-sdk",
      "inherits": "base-test",
      "configurePreset": "ci-macos-sdk"
    }
  ]
