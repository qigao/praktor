{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "C:/projects/cpp",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "C:/tools/vcpkg",
                "USER_ROOT": "C:/Users/lockg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PKG_ROOT": "/opt",
                "VCPKG_ROOT": "/opt/vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "environment": {
                "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            }
        },
        {
            "name": "android-win-paths",
            "hidden": true,
            "inherits": "ISWindows",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
            }
        },
        {
            "name": "win-dev-user",
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ],
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script/debug",
                "SALTS_VCPKG_RUNTIME_BIN": "$env{PROJECT_ROOT}/turbonet/salts/vcpkg_installed/x64-windows/debug/bin",
                "VCPKG_RUNTIME_BIN": "$env{SALTS_VCPKG_RUNTIME_BIN}",
                "PATH": "${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_VCPKG_RUNTIME_BIN}${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{TURBOSCRIPT_ROOT}/bin${pathListSep}$penv{PATH}",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/debug"
            },
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor/debug"
            }
        },
        {
            "name": "win-release-user",
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ],
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script/release",
                "SALTS_VCPKG_RUNTIME_BIN": "$env{PROJECT_ROOT}/turbonet/salts/vcpkg_installed/x64-windows/bin",
                "VCPKG_RUNTIME_BIN": "$env{SALTS_VCPKG_RUNTIME_BIN}",
                "PATH": "${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_VCPKG_RUNTIME_BIN}${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{TURBOSCRIPT_ROOT}/bin${pathListSep}$penv{PATH}",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/release"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "ENABLE_TESTS": "ON",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor/release"
            }
        },
        {
            "name": "linux-dev-user",
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ],
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script/debug",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/debug"
            },
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor/debug"
            }
        },
        {
            "name": "linux-release-user",
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ],
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script/release",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{TURBOSCRIPT_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/release"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "ENABLE_TESTS": "ON",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor/release"
            }
        },
        {
            "name": "linux-sdk-package",
            "inherits": [
                "linux-release-user"
            ],
            "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "ENABLE_TESTS": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug",
                "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script-android/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp-android/debug"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor-android/debug"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/release",
                "TURBOSCRIPT_ROOT": "$env{PKG_ROOT}/turbo_script-android/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp-android/release"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/praktor-android/release"
            }
        },
        {
            "name": "android-arm64-v8a-debug-win",
            "inherits": [
                "android-arm64-v8a-debug",
                "android-dependencies-debug",
                "android-win-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-arm64-v8a-release-win",
            "inherits": [
                "android-arm64-v8a-release",
                "android-dependencies-release",
                "android-win-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-x86_64-debug-win",
            "inherits": [
                "android-x86_64-debug",
                "android-dependencies-debug",
                "android-win-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-x86_64-release-win",
            "inherits": [
                "android-x86_64-release",
                "android-dependencies-release",
                "android-win-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-x86-debug-win",
            "inherits": [
                "android-x86-debug",
                "android-dependencies-debug",
                "android-win-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-x86-release-win",
            "inherits": [
                "android-x86-release",
                "android-dependencies-release",
                "android-win-paths",
                "android-win-environment"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "win-dev-user",
            "configurePreset": "win-dev-user"
