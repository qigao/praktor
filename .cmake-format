format:
  line_width: 80
  tab_size: 4
  max_pargs_hwrap: 6
  max_subgroups_hwrap: 2
  max_rows_cmdline: 2
  dangle_parens: true
  dangle_align: prefix
  min_prefix_chars: 4
  max_prefix_chars: 10
  max_lines_hwrap: 2
  command_case: canonical
  keyword_case: unchanged
  enable_sort: false
  autosort: false
