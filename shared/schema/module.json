{
  "include": [
    "test/module.json"
  ],
  "targets": {
    "praktor_schema_projection": {
      "kind": "static",
      "sources": {
        "files": [
          "projection.c"
        ]
      },
      "public": {
        "includeDirs": [
          "."
        ],
        "deps": [
          "saltsbase_json"
        ]
      },
      "private": {
        "deps": [
          "saltsutils_idl",
          "saltsutils_schema",
          "saltsbase_core"
        ]
      },
      "when": {
        "native": true
      }
    },
    "praktor-schema": {
      "kind": "executable",
      "testOnly": false,
      "sources": {
        "files": [
          "main.c"
        ]
      },
      "private": {
        "deps": [
          "praktor_schema_projection",
          "saltsbase_core"
        ]
      },
      "when": {
        "native": true
      },
      "test": {
        "name": "schema_projection_cli",
        "args": [
          "$root/schema/workflow.schema",
          "$root/schema/workflow.editor.json",
          "$builddir/workflow.cli.json"
        ],
        "labels": [
          "schema"
        ]
      }
    }
  }
}
