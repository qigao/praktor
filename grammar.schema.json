{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Praktor Workflow Specification",
  "description": "A schema for defining Praktor DSL (v9.0) workflow files.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable workflow identifier."
    },
    "description": {
      "type": "string",
      "description": "Optional workflow summary."
    },
    "variables": {
      "$ref": "#/$defs/stringMap",
      "description": "Global variables available for Mustache templating and expression evaluation."
    },
    "env": {
      "$ref": "#/$defs/stringMap",
      "description": "Global environment variables available to all tasks."
    },
    "dotEnv": {
      "description": "Paths to .env files to load into the global environment.",
      "$ref": "#/$defs/stringOrStringArray"
    },
    "defaults": {
      "type": "object",
      "description": "Default attributes applied to all tasks.",
      "properties": {
        "retries": {
          "$ref": "#/$defs/retriesPolicy"
        },
        "timeout": {
          "$ref": "#/$defs/durationString"
        }
      },
      "additionalProperties": false
    },
    "native_modules": {
      "type": "array",
      "description": "Native DLL/SO modules to load for script execution.",
      "items": {
        "$ref": "#/$defs/nativeModule"
      }
    },
    "tasks": {
      "type": "array",
      "description": "The list of all task definitions in the workflow.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taskDefinition"
      }
    }
  },
  "required": [
    "tasks"
  ],
  "additionalProperties": false,
  "$defs": {
    "stringOrStringArray": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "stringMap": {
      "type": "object",
      "description": "A mapping of keys to values. Values support Mustache templating and variable interpolation.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "durationString": {
      "type": "string",
      "description": "A duration string, e.g., '30s', '5m', '1h'.",
      "pattern": "^[0-9]+(s|m|h)$"
    },
    "retriesPolicy": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of retry attempts."
        },
        "delay": {
          "$ref": "#/$defs/durationString",
          "description": "The delay between attempts."
        },
        "on_exit_codes": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Only retry if exit code matches one of these values. If omitted, retries on any non-zero exit code."
        },
        "on_stderr_pattern": {
          "type": "string",
          "description": "Only retry if stderr matches this regex pattern. Useful for retrying on specific error messages."
        },
        "backoff": {
          "type": "string",
          "enum": ["linear", "exponential"],
          "default": "linear",
          "description": "Backoff strategy: 'linear' (constant delay) or 'exponential' (delay doubles each retry)."
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
    },
    "nativeModule": {
      "type": "object",
      "description": "A native DLL/SO module loaded at startup.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Module name for identification."
        },
        "path": {
          "type": "string",
          "description": "Path to the DLL (Windows) or SO (Linux/macOS) file."
        },
        "hooks": {
          "type": "object",
          "description": "Hook function mappings.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["name", "path"],
      "additionalProperties": false
    },
    "triggerActionList": {
      "type": "array",
      "description": "A list of task names to execute when a trigger event fires.",
      "items": {
        "type": "string",
        "description": "Name of a task to execute as a trigger action."
      },
      "minItems": 1
    },
    "triggersBlock": {
      "type": "object",
      "description": "Defines event-driven actions to take upon task completion.",
      "properties": {
        "on_success": {
          "$ref": "#/$defs/triggerActionList",
          "description": "Tasks to execute when the task completes successfully."
        },
        "on_failure": {
          "$ref": "#/$defs/triggerActionList",
          "description": "Tasks to execute when the task fails (after all retries)."
        },
        "on_complete": {
          "$ref": "#/$defs/triggerActionList",
          "description": "Tasks to execute regardless of success or failure."
        }
      },
      "additionalProperties": false
    },
    "eachBlock": {
      "type": "object",
      "properties": {
        "items": {
          "$ref": "#/$defs/stringOrStringArray"
        },
        "matrix": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stringOrStringArray"
          }
        },
        "as": {
          "type": "string"
        },
        "index_variable": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "items"
          ]
        },
        {
          "required": [
            "matrix"
          ]
        }
      ],
      "additionalProperties": false
    },
    "taskDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "depends_on": {
          "$ref": "#/$defs/stringOrStringArray"
        },
        "vars": {
          "$ref": "#/$defs/stringMap"
        },
        "env": {
          "$ref": "#/$defs/stringMap"
        },
        "dotEnv": {
          "$ref": "#/$defs/stringOrStringArray"
        },
        "timeout": {
          "$ref": "#/$defs/durationString"
        },
        "retries": {
          "$ref": "#/$defs/retriesPolicy"
        },
        "when": {
          "type": "string"
        },
        "each": {
          "$ref": "#/$defs/eachBlock"
        },
        "triggers": {
          "$ref": "#/$defs/triggersBlock"
        },
        "continue_on_error": {
          "type": "boolean",
          "description": "If true, workflow continues even if this task fails.",
          "default": false
        },
        "working_dir": {
          "type": "string",
          "description": "Working directory for command execution."
        },
        "silent": {
          "type": "boolean",
          "description": "Suppress command output.",
          "default": false
        },
        "command": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "output_format": {
          "enum": [
            "text",
            "json"
          ]
        },
        "script": {
          "type": "string",
          "description": "Post-processing script executed after the task action completes. Uses the built-in scripting language with access to ctx, json, dll, http, and log modules."
        },
        "uses": {
          "type": "string"
        },
        "dynamic_tasks": {
          "type": "object",
          "description": "Generate and execute tasks dynamically at runtime.",
          "properties": {
            "items_variable": {
              "type": "string",
              "description": "Context path to a JSON array that drives task generation."
            },
            "template": {
              "type": "object",
              "description": "Task template with {{ item }} placeholders.",
              "properties": {
                "name": { "type": "string" },
                "command": { "$ref": "#/$defs/stringOrStringArray" },
                "timeout": { "$ref": "#/$defs/durationString" },
                "retries": { "$ref": "#/$defs/retriesPolicy" },
                "when": { "type": "string" },
                "depends_on": { "$ref": "#/$defs/stringOrStringArray" },
                "env": { "$ref": "#/$defs/stringMap" }
              },
              "required": ["name", "command"]
            }
          },
          "required": ["items_variable", "template"],
          "additionalProperties": false
        },
        "sequence": {
          "$ref": "#/$defs/orchestrationNodeChildren"
        },
        "fallback": {
          "$ref": "#/$defs/orchestrationNodeChildren"
        },
        "parallel": {
          "$ref": "#/$defs/orchestrationNodeChildren"
        },
        "reactive_sequence": {
          "$ref": "#/$defs/orchestrationNodeChildren"
        },
        "reactive_fallback": {
          "$ref": "#/$defs/orchestrationNodeChildren"
        },
        "shell": {
          "$ref": "#/$defs/orchestrationShellNode"
        },
        "parse_json": {
          "$ref": "#/$defs/orchestrationParseJsonNode"
        },
        "parse_regex": {
          "$ref": "#/$defs/orchestrationParseRegexNode"
        },
        "parse_lines": {
          "$ref": "#/$defs/orchestrationParseLinesNode"
        },
        "parse_keyvalue": {
          "$ref": "#/$defs/orchestrationParseKeyValueNode"
        },
        "check_exit_code": {
          "$ref": "#/$defs/orchestrationCheckExitCodeNode"
        },
        "wait_event": {
          "$ref": "#/$defs/orchestrationWaitEventNode"
        },
        "file_exists": {
          "$ref": "#/$defs/orchestrationFileExistsNode"
        },
        "sleep": {
          "$ref": "#/$defs/orchestrationSleepNode"
        },
        "set_variable": {
          "$ref": "#/$defs/orchestrationSetVariableNode"
        },
        "subtree": {
          "$ref": "#/$defs/orchestrationSubTreeNode"
        }
      },
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "uses"
          ]
        },
        {
          "required": [
            "dynamic_tasks"
          ]
        },
        {
          "required": [
            "sequence"
          ]
        },
        {
          "required": [
            "fallback"
          ]
        },
        {
          "required": [
            "parallel"
          ]
        },
        {
          "required": [
            "reactive_sequence"
          ]
        },
        {
          "required": [
            "reactive_fallback"
          ]
        },
        {
          "required": [
            "shell"
          ]
        },
        {
          "required": [
            "parse_json"
          ]
        },
        {
          "required": [
            "parse_regex"
          ]
        },
        {
          "required": [
            "parse_lines"
          ]
        },
        {
          "required": [
            "parse_keyvalue"
          ]
        },
        {
          "required": [
            "check_exit_code"
          ]
        },
        {
          "required": [
            "wait_event"
          ]
        },
        {
          "required": [
            "file_exists"
          ]
        },
        {
          "required": [
            "sleep"
          ]
        },
        {
          "required": [
            "set_variable"
          ]
        },
        {
          "required": [
            "script"
          ]
        },
        {
          "required": [
            "subtree"
          ]
        }
      ],
      "additionalProperties": false
    },
    "orchestrationNode": {
      "oneOf": [
        { "$ref": "#/$defs/orchestrationControlNode" },
        { "$ref": "#/$defs/orchestrationLeafNode" }
      ]
    },
    "orchestrationControlNode": {
      "oneOf": [
        { "type": "object", "properties": { "sequence": { "$ref": "#/$defs/orchestrationNodeChildren" } }, "required": ["sequence"], "additionalProperties": false },
        { "type": "object", "properties": { "fallback": { "$ref": "#/$defs/orchestrationNodeChildren" } }, "required": ["fallback"], "additionalProperties": false },
        { "type": "object", "properties": { "parallel": { "$ref": "#/$defs/orchestrationNodeChildren" } }, "required": ["parallel"], "additionalProperties": false },
        { "type": "object", "properties": { "reactive_sequence": { "$ref": "#/$defs/orchestrationNodeChildren" } }, "required": ["reactive_sequence"], "additionalProperties": false },
        { "type": "object", "properties": { "reactive_fallback": { "$ref": "#/$defs/orchestrationNodeChildren" } }, "required": ["reactive_fallback"], "additionalProperties": false }
      ]
    },
    "orchestrationLeafNode": {
      "oneOf": [
        { "type": "object", "properties": { "shell": { "$ref": "#/$defs/orchestrationShellNode" } }, "required": ["shell"], "additionalProperties": false },
        { "type": "object", "properties": { "parse_json": { "$ref": "#/$defs/orchestrationParseJsonNode" } }, "required": ["parse_json"], "additionalProperties": false },
        { "type": "object", "properties": { "parse_regex": { "$ref": "#/$defs/orchestrationParseRegexNode" } }, "required": ["parse_regex"], "additionalProperties": false },
        { "type": "object", "properties": { "parse_lines": { "$ref": "#/$defs/orchestrationParseLinesNode" } }, "required": ["parse_lines"], "additionalProperties": false },
        { "type": "object", "properties": { "parse_keyvalue": { "$ref": "#/$defs/orchestrationParseKeyValueNode" } }, "required": ["parse_keyvalue"], "additionalProperties": false },
        { "type": "object", "properties": { "check_exit_code": { "$ref": "#/$defs/orchestrationCheckExitCodeNode" } }, "required": ["check_exit_code"], "additionalProperties": false },
        { "type": "object", "properties": { "wait_event": { "$ref": "#/$defs/orchestrationWaitEventNode" } }, "required": ["wait_event"], "additionalProperties": false },
        { "type": "object", "properties": { "file_exists": { "$ref": "#/$defs/orchestrationFileExistsNode" } }, "required": ["file_exists"], "additionalProperties": false },
        { "type": "object", "properties": { "sleep": { "$ref": "#/$defs/orchestrationSleepNode" } }, "required": ["sleep"], "additionalProperties": false },
        { "type": "object", "properties": { "set_variable": { "$ref": "#/$defs/orchestrationSetVariableNode" } }, "required": ["set_variable"], "additionalProperties": false },
        { "type": "object", "properties": { "subtree": { "$ref": "#/$defs/orchestrationSubTreeNode" } }, "required": ["subtree"], "additionalProperties": false }
      ]
    },
    "orchestrationNodeChildren": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/orchestrationNode" },
          "minItems": 1
        },
        { "$ref": "#/$defs/orchestrationNode" }
      ]
    },
    "orchestrationShellNode": {
      "oneOf": [
        {
          "type": "string",
          "description": "Simple syntax: shell command as a string"
        },
        {
          "type": "object",
          "description": "Map syntax: shell command with parameters",
          "properties": {
            "cmd": {
              "type": "string",
              "description": "Shell command to execute"
            },
            "output_key": {
              "type": "string",
              "description": "Blackboard key to store stdout"
            },
            "timeout": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" }
              ],
              "description": "Execution timeout"
            }
          },
          "required": ["cmd"],
          "additionalProperties": false
        }
      ]
    },
    "orchestrationParseJsonNode": {
      "type": "object",
      "properties": {
        "input_key": {
          "type": "string",
          "description": "Blackboard key containing JSON data"
        },
        "path": {
          "type": "string",
          "description": "JSONPath expression to extract data"
        },
        "output_key": {
          "type": "string",
          "description": "Blackboard key to store extracted data"
        }
      },
      "required": ["input_key"],
      "additionalProperties": false
    },
    "orchestrationParseRegexNode": {
      "type": "object",
      "properties": {
        "input_key": {
          "type": "string",
          "description": "Blackboard key containing text data"
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression pattern"
        },
        "capture_group": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" }
          ],
          "description": "Capture group to extract (default: 0)"
        },
        "output_key": {
          "type": "string",
          "description": "Blackboard key to store extracted data"
        }
      },
      "required": ["input_key", "pattern"],
      "additionalProperties": false
    },
    "orchestrationParseLinesNode": {
      "type": "object",
      "properties": {
        "input_key": {
          "type": "string",
          "description": "Blackboard key containing text data"
        },
        "filter": {
          "type": "string",
          "description": "Optional regex filter for matching lines"
        },
        "output_key": {
          "type": "string",
          "description": "Blackboard key to store extracted lines"
        }
      },
      "required": ["input_key"],
      "additionalProperties": false
    },
    "orchestrationParseKeyValueNode": {
      "type": "object",
      "properties": {
        "input_key": {
          "type": "string",
          "description": "Blackboard key containing key/value text"
        },
        "delimiter": {
          "type": "string",
          "description": "Key/value delimiter"
        },
        "line_separator": {
          "type": "string",
          "description": "Line separator"
        },
        "output_key": {
          "type": "string",
          "description": "Blackboard key to store parsed key/value data"
        }
      },
      "required": ["input_key"],
      "additionalProperties": false
    },
    "orchestrationCheckExitCodeNode": {
      "type": "object",
      "properties": {
        "input_key": {
          "type": "string",
          "description": "Blackboard key containing exit code"
        },
        "expected": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" }
          ],
          "description": "Expected exit code value"
        }
      },
      "required": ["expected"],
      "additionalProperties": false
    },
    "orchestrationWaitEventNode": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "description": "Event name to wait for"
        },
        "timeout": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" }
          ],
          "description": "Wait timeout"
        }
      },
      "required": ["event"],
      "additionalProperties": false
    },
    "orchestrationFileExistsNode": {
      "oneOf": [
        {
          "type": "string",
          "description": "Simple syntax: file path to check"
        },
        {
          "type": "object",
          "description": "Map syntax: file check with parameters",
          "properties": {
            "path": {
              "type": "string",
              "description": "File path to check (supports {ctx.*} syntax)"
            },
            "output_key": {
              "type": "string",
              "description": "Blackboard key to store result (true/false)"
            },
            "fail_if_missing": {
              "type": "boolean",
              "default": true,
              "description": "Fail the node if file doesn't exist (default: true)"
            }
          },
          "required": ["path"],
          "additionalProperties": false
        }
      ]
    },
    "orchestrationSleepNode": {
      "oneOf": [
        {
          "type": "number",
          "description": "Simple syntax: sleep duration in milliseconds"
        },
        {
          "type": "string",
          "description": "Simple syntax: sleep duration as string (e.g., '5s', '100ms')"
        },
        {
          "type": "object",
          "description": "Map syntax: sleep with parameters",
          "properties": {
            "duration": {
              "oneOf": [
                { "type": "number" },
                { "type": "string" }
              ],
              "description": "Sleep duration (number in ms or string like '5s')"
            },
            "reason": {
              "type": "string",
              "description": "Optional reason for the delay (for logging)"
            }
          },
          "required": ["duration"],
          "additionalProperties": false
        }
      ]
    },
    "orchestrationSetVariableNode": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Blackboard key to set"
        },
        "value": {
          "description": "Value to set (supports {ctx.*} syntax)"
        },
        "from_context": {
          "type": "string",
          "description": "Alternative: copy value from context path"
        }
      },
      "oneOf": [
        { "required": ["key", "value"] },
        { "required": ["key", "from_context"] }
      ],
      "additionalProperties": false
    },
    "orchestrationSubTreeNode": {
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Registered subtree identifier"
        }
      },
      "required": ["ID"],
      "additionalProperties": false
    }
  }
}
