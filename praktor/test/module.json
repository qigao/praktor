    "praktor_cli_test": {
      "kind": "executable",
      "sources": {
        "files": [
          "praktor_cli_test.c"
        ]
      },
      "private": {
        "deps": [
          "saltsbase_json",
          "saltsbase_tinytest",
          "saltsbase_core",
          "saltsbase_query"
        ],
        "defines": {
          "PRAKTOR_CLI_BASIC_EXAMPLE": "\"$root/examples/basic.yml\"",
          "PRAKTOR_CLI_ENV_WORKFLOW": "\"$builddir/fixtures/cli-env.yml\"",
          "PRAKTOR_CLI_INVALID_DEFAULTS_WORKFLOW": "\"$builddir/fixtures/cli-invalid-defaults.yml\"",
          "PRAKTOR_CLI_PATH": "\"$builddir/bin/praktor${host:exe}\"",
          "PRAKTOR_CLI_TASK_WORKFLOW": "\"$root/praktor/test/data/cli-tasks.yml\"",
          "PRAKTOR_CLI_TIMEOUT_WORKFLOW": "\"$root/praktor/test/data/cli-timeout.yml\"",
          "PRAKTOR_CLI_WORKFLOW": "\"$root/praktor/test/data/cli-shell.yml\""
        }
      },
      "when": {
        "native": true
      },
      "test": {
        "labels": [
          "praktor"
        ],
        "timeout": 30
      },
      "runtimeDeps": [
        "praktor"
      ],
      "preTasks": [
        {
          "name": "configure-cli-invalid-defaults",
          "tool": "praktor_fixture_configure",
          "inputs": [
            "data/cli-invalid-defaults.yml.in"
          ],
          "outputs": [
            "$builddir/fixtures/cli-invalid-defaults.yml"
          ],
          "args": [
            "$moduledir/data/cli-invalid-defaults.yml.in",
            "$builddir/fixtures/cli-invalid-defaults.yml",
            "@CMAKE_CURRENT_SOURCE_DIR@",
            "$moduledir"
          ]
        }
      ],
      "variants": [
        {
          "when": {
            "os": "windows"
          },
          "preTasks": [
            {
              "name": "configure-cli-env",
              "tool": "praktor_fixture_configure",
              "inputs": [
                "data/cli-env.yml.in"
              ],
              "outputs": [
                "$builddir/fixtures/cli-env.yml"
              ],
              "args": [
                "$moduledir/data/cli-env.yml.in",
                "$builddir/fixtures/cli-env.yml",
                "@CMAKE_CURRENT_SOURCE_DIR@",
                "$moduledir",
                "@PRAKTOR_CLI_ENV_COMMAND@",
                "echo %PRAKTOR_CLI_ENV_TEST_VALUE%"
              ]
            }
          ]
        },
        {
          "when": {
            "os": [
              "linux",
              "macos",
              "android"
            ]
          },
          "preTasks": [
            {
              "name": "configure-cli-env",
              "tool": "praktor_fixture_configure",
              "inputs": [
                "data/cli-env.yml.in"
              ],
              "outputs": [
                "$builddir/fixtures/cli-env.yml"
              ],
              "args": [
                "$moduledir/data/cli-env.yml.in",
                "$builddir/fixtures/cli-env.yml",
                "@CMAKE_CURRENT_SOURCE_DIR@",
                "$moduledir",
                "@PRAKTOR_CLI_ENV_COMMAND@",
                "echo $PRAKTOR_CLI_ENV_TEST_VALUE"
              ]
            }
          ]
        }
      ]
    },
