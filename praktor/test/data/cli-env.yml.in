dotEnv: ['@CMAKE_CURRENT_SOURCE_DIR@/data/cli.env']
defaults:
  timeout: 5000
  stream_output: false
variables:
  command: echo root-scope
tasks:
  - name: root
    shell:
      cmd: $command
  - name: overlay
    depends_on: [root]
    vars:
      command: @PRAKTOR_CLI_ENV_COMMAND@
    shell:
      cmd: $command
  - name: matrix
    depends_on: [overlay]
    dynamic_tasks:
      items_variable: $PRAKTOR_CLI_MATRIX
      template:
        name: $item-$index
        assert: {guard: {fields: [item], match: '$item == "dotenv"'}}
