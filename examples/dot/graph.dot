digraph PraktorWorkflow {
    rankdir=LR;
    node [shape=box, style=rounded, fontname="Arial"];
    label="{{#name}}{{name}}{{/name}}{{^name}}Praktor Workflow{{/name}}";
    labelloc="t";

{{#tasks}}
    "{{name}}" [label="{{name}}{{#description}}\n({{description}}){{/description}}"];
{{/tasks}}

{{#tasks}}
{{#depends_on}}
    "{{.}}" -> "{{name}}";
{{/depends_on}}
{{/tasks}}
}
