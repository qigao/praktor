{
  "version": 6,
  "configurePresets": [
    {
      "name": "default-options",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "developer-mode",
      "hidden": true,
      "inherits": "default-options",
      "environment": {
        "VCPKG_CONFIGURATION_SUBDIR": "debug/"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release-mode",
      "hidden": true,
      "inherits": "default-options",
      "environment": {
        "VCPKG_CONFIGURATION_SUBDIR": ""
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
