{
  "version": 6,
  "configurePresets": [
    {
      "name": "schema-c-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../build/schema-c-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "CMAKE_EXPORT_COMPILE_COMMANDS": true}
    },
    {
      "name": "schema-c-asan",
      "inherits": "schema-c-release",
      "binaryDir": "${sourceDir}/../../../build/schema-c-asan",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {"name": "schema-c-release", "configurePreset": "schema-c-release", "jobs": 2},
    {"name": "schema-c-asan", "configurePreset": "schema-c-asan", "jobs": 2}
  ],
  "testPresets": [
    {"name": "schema-c-release", "configurePreset": "schema-c-release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "schema-c-asan", "configurePreset": "schema-c-asan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
