<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Praktor.Native</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.4.6</PackageVersion>
    <Authors>qigao</Authors>
    <Description>Praktor script-enabled native SDK for Linux x64, macOS arm64 and Android arm64-v8a.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/qigao/praktor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SaltsUtilsVersion Condition="'$(SaltsUtilsVersion)' == ''">*-*</SaltsUtilsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Salts.Native" Version="*-*" />
    <PackageReference Include="SaltsUtils.Native" Version="$(SaltsUtilsVersion)" />
    <PackageReference Include="CHttp.Native" Version="*" />
    <PackageReference Include="TurboScript.Native" Version="*" Condition="'$(EnableScriptEngine)' != 'False'" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(PackageRoot)/sdk/**/*" Pack="true" PackagePath="sdk/" />
  </ItemGroup>
</Project>
