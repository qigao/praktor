# Import these values in the parent environment before invoking CMake presets.
# Use absolute paths with forward slashes. CMake does not load .env itself.
VSDEVCMD_BAT=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
VCPKG_ROOT=C:/tools/vcpkg
VCPKG_CACHE_REPOSITORY_ROOT=C:/path/to/vcpkg-cache

# Reuse an already restored, compiler-matched vcpkg-cache payload.
# This directory contains triplets; it is not a triplet directory itself.
# Configure does not invoke vcpkg or build dependency ports.
VCPKG_CACHE_VERSION=0.1.3
VCPKG_INSTALLED_DIR=C:/path/to/vcpkg-cache-payload/vcpkg_installed

# Runtime profiles also consume this repository's manifest installation.
# Its default is <repository>/vcpkg_installed, separate from the shared payload.
# Restore with vcpkg install using the same target/host triplet and the shared
# cache repository's triplets. Compiler setup exports this plain toolchain:
# LLVM_MINGW_HOST_DEPENDENCY_TOOLCHAIN_FILE=C:/path/to/qigao-host-toolchain.cmake
# VCPKG_BINARY_SOURCES=clear;default,readwrite;nugettimeout,1800;nugetconfig,C:/path/to/Praktor/cmake/vcpkg-cache.nuget.config,read

# Matching installed split SDKs. Their package configs enforce compatibility.
SALTS_BASE_VERSION=0.1.6
SALTS_BASE_ROOT=C:/path/to/salts-base-sdk
CMETA_VERSION=0.1.6
CMETA_ROOT=C:/path/to/cmeta-sdk
SALTS_UTILS_VERSION=0.1.3
SALTS_UTILS_ROOT=C:/path/to/salts-utils-sdk

# llvm-mingw-x64-release-user selects its triplet and compiler target.
# Other platform profiles use their existing environment variables.
# GCC_TARGET_TRIPLET=x64-linux
# MSVC_TARGET_TRIPLET=x64-windows
# LLVM_MINGW_TARGET=x86_64-w64-mingw32

# Installation defaults to build/<preset>/stage for complete runtime profiles.

# Optional Praktor per-command defaults, read after native dotEnv loading.
# Document defaults and explicit Shell options override these values.
# PRAKTOR_TIMEOUT_MS=30000
# PRAKTOR_STREAM_OUTPUT=true

# Authentication is needed only when restoring authenticated upstream packages.
# Never commit credentials. An installed payload needs no feed access.
# GITHUB_TOKEN=
